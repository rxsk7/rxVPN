{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "rxvpn",
  "version": "0.16.2",
  "identifier": "dev.rxmv.rxvpn",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "rxvpn",
        "width": 980,
        "height": 720,
        "minWidth": 380,
        "minHeight": 600,
        "backgroundColor": "#0E1014"
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "rxmv",
    "shortDescription": "VPN-клиент на Xray",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Russian"
        ],
        "displayLanguageSelector": false
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
